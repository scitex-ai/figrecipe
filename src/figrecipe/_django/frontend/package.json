{
  "name": "figrecipe-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./bridge/*": {
      "import": "./src/bridge/*.ts",
      "types": "./src/bridge/*.ts"
    },
    "./dist": {
      "import": "./dist/figrecipe-editor.js"
    },
    "./styles": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --config vite.config.lib.ts",
    "preview": "vite preview"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0",
    "@scitex/ui": "file:../../../../../scitex-ui"
  },
  "scitexUi": {
    "version": "0.23.0",
    "tag": "v0.23.0",
    "commit": "e081f1def88d7c7a3d88af3601dd0e94e117e818",
    "reason": "The editor imports owner source by deep path (ts/_base/gettext.ts, react/app/data-table, react/app/selector-nav, react/app/alert-banner, react/app/usePanelResize, react/app/bridge, ts/shell/*, ts/app/panes, ts/app/project-selector/types, css/*). 0.20.2 - the version the lock used to record - has none of the newer ones. tests/scitexUiContract.test.ts enforces this requirement against the sibling checkout."
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  }
}
