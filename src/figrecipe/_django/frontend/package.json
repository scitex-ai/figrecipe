{
  "name": "figrecipe-editor",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "main": "./src/index.ts",
  "types": "./src/index.ts",
  "exports": {
    ".": {
      "import": "./src/index.ts",
      "types": "./src/index.ts"
    },
    "./bridge/*": {
      "import": "./src/bridge/*.ts",
      "types": "./src/bridge/*.ts"
    },
    "./dist": {
      "import": "./dist/figrecipe-editor.js"
    },
    "./styles": "./dist/style.css"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:lib": "tsc && vite build --config vite.config.lib.ts",
    "preview": "vite preview",
    "configure": "python configure.py"
  },
  "dependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.0",
    "@scitex/sdk": "file:../../../../../scitex-sdk/src/scitex_sdk"
  },
  "peerDependencies": {
    "react": "^18.3.1",
    "react-dom": "^18.3.1"
  },
  "devDependencies": {
    "@types/react": "^18.3.0",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.0",
    "typescript": "^5.5.0",
    "vite": "^5.4.0"
  },
  "scitexSdk": {
    "version": "0.3.0",
    "commit": "9bf0851cbe0a5ab90b334c235fc08b7d0d4a4ebb",
    "reason": "Canonical SDK app/UI ownership; this pinned unpublished source is required before consumer publication."
  }
}
